# Synora Healthcare Backend Configuration
SECRET_KEY=django-insecure-synora-healthcare-super-secret-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (PostgreSQL)
# Leave DB_HOST blank to use SQLite for development/testing, or provide PostgreSQL credentials
DB_ENGINE=sqlite3
DB_NAME=synora_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# JWT Lifetime Settings
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=1

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000
